# See https://help.github.com/articles/ignoring-files/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.key
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — never commit secrets
.env
.env.*
!.env.example

# local blob / ephemeral data
.data/
/tmp/

# vercel / render local
.vercel
.render

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / OS
.idea/
.vscode/
*.swp
*~

# cloudflared / agent logs
*.log
/cloudflared
